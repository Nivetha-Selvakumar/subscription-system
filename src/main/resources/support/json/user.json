{
  "userCreate": {
    "body": [
      {
        "name": "empId",
        "required": true,
        "maxLength": 20,
        "format": "^[A-Za-z0-9-]+$",
        "displayName": "Employee ID"
      },
      {
        "name": "firstName",
        "required": true,
        "maxLength": 50,
        "format": "^[A-Za-z]+$",
        "displayName": "First Name"
      },
      {
        "name": "lastName",
        "required": true,
        "maxLength": 50,
        "format": "^[A-Za-z]+$",
        "displayName": "Last Name"
      },
      {
        "name": "email",
        "required": true,
        "maxLength": 100,
        "format": "^[\\w.%+-]+@[\\w.-]+\\.[A-Za-z]{2,6}$",
        "displayName": "Email Address"
      },
      {
        "name": "address",
        "required": false,
        "maxLength": 150,
        "format": null,
        "displayName": "Address"
      },
      {
        "name": "dateOfBirth",
        "required": false,
        "maxLength": 10,
        "format": "^\\d{4}-\\d{2}-\\d{2}$",
        "displayName": "Date of Birth"
      },
      {
        "name": "phoneNumber",
        "required": true,
        "maxLength": 15,
        "format": "^[0-9]{10,15}$",
        "displayName": "Phone Number"
      },
      {
        "name": "sex",
        "required": true,
        "maxLength": 1,
        "format": "^[MFmf]$",
        "displayName": "Sex"
      },
      {
        "name": "role",
        "required": true,
        "maxLength": 30,
        "format": "^[A-Za-z]+$",
        "displayName": "Role"
      }
    ]
  }
